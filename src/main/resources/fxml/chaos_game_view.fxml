<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  ChaosGame layout:
    TOP    – instruction banner
    CENTER – sandbox Pane (canvas fills it, vertices are added programmatically)
    BOTTOM – dice-result strip
    RIGHT  – controls panel (mode, dice, sliders, play/pause, reset)
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mathamorphosis.ui.visualizations.ChaosGameViewController"
            style="-fx-background-color: #0c0c1e;">

    <!-- ═══════════════════ TOP: Instruction banner ═══════════════════ -->
    <top>
        <Label fx:id="instructionLabel" alignment="CENTER" maxWidth="Infinity"
               style="-fx-font-size:18px; -fx-text-fill:#eab308; -fx-font-weight:bold;
                      -fx-padding:12px; -fx-background-color:#1c1c38;"/>
    </top>

    <!-- ═══════════════════ CENTER: Canvas sandbox ═══════════════════ -->
    <center>
        <!-- sandbox Pane — canvas is bound to its size, vertices added in code -->
        <Pane fx:id="sandbox" style="-fx-background-color:#14142a;"/>
    </center>

    <!-- ═══════════════════ BOTTOM: Dice result strip ═══════════════════ -->
    <bottom>
        <Label fx:id="diceResultLabel" text="" alignment="CENTER"
               maxWidth="Infinity" prefHeight="36" minHeight="36"
               style="-fx-font-size:15px; -fx-font-weight:bold; -fx-padding:6 14;
                      -fx-background-color:#1a1a36; -fx-background-radius:0;"/>
    </bottom>

    <!-- ═══════════════════ RIGHT: Controls panel ═══════════════════ -->
    <right>
        <VBox spacing="18" alignment="TOP_CENTER" prefWidth="320"
              style="-fx-background-color:#1c1c38;">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <Label text="CONTROLS"
                   style="-fx-font-size:18px; -fx-text-fill:white; -fx-font-weight:bold;"/>

            <Button fx:id="modeBtn" text="Switch to Manual Mode" maxWidth="Infinity"
                    styleClass="back-button"/>

            <Separator style="-fx-background-color:#333;"/>

            <!-- Dice display -->
            <StackPane alignment="CENTER" minWidth="120" minHeight="120">
                <VBox.margin><Insets top="10" bottom="10"/></VBox.margin>
                <Pane fx:id="dicePane" minWidth="120" minHeight="120"
                      prefWidth="120" prefHeight="120" maxWidth="120" maxHeight="120"
                      style="-fx-background-color:transparent;">
                    <Canvas fx:id="diceCanvas" width="120" height="120"/>
                </Pane>
            </StackPane>

            <Button fx:id="diceBtn" text="🎲  Roll Dice" maxWidth="Infinity"
                    styleClass="back-button"
                    style="-fx-background-color:#7f1d1d; -fx-text-fill:white;
                           -fx-font-size:15px; -fx-font-weight:bold;"/>

            <Button fx:id="simulateRestBtn" text="▶  Simulate the Rest" maxWidth="Infinity"
                    styleClass="back-button"/>

            <Separator style="-fx-background-color:#333;"/>

            <Label text="Auto Speed (dots / frame)"
                   style="-fx-text-fill:#aaa; -fx-font-size:12px;"/>
            <Slider fx:id="speedSlider" min="1" max="100" value="10"
                    showTickLabels="true" showTickMarks="true"
                    majorTickUnit="10" minorTickCount="0" snapToTicks="false"/>

            <Label text="Jump Distance"
                   style="-fx-text-fill:#aaa; -fx-font-size:12px;"/>
            <Slider fx:id="distSlider" min="0.1" max="0.9" value="0.5"
                    showTickLabels="true" showTickMarks="true"
                    majorTickUnit="0.1" blockIncrement="0.01"/>

            <Button fx:id="playPauseBtn" text="⏯  Play / Pause" maxWidth="Infinity"
                    styleClass="back-button"/>

            <Button fx:id="resetBtn" text="⟳  Reset Setup" maxWidth="Infinity"
                    styleClass="back-button"
                    style="-fx-background-color:#ef4444; -fx-text-fill:white; -fx-font-weight:bold;"/>
        </VBox>
    </right>

</BorderPane>
