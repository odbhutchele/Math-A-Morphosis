<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mathamorphosis.ui.visualizations.RiemannViewController"
            fx:id="rootPane"
            style="-fx-background-color: #1a1a2e;">

    <!-- ═══════════════════ TOP: Header ═══════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: #22223a; -fx-border-color: #3c3c60; -fx-border-width: 0 0 1 0;">
            <padding><Insets top="20" right="24" bottom="16" left="24"/></padding>

            <!-- Title + Subtitle -->
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Riemann Sum Explorer"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f0f0f8;"/>
                <Label text="Visualise how infinitely many rectangles approximate the area under any curve"
                       style="-fx-font-size: 13px; -fx-text-fill: #8888aa;"/>
            </VBox>

            <!-- Preset buttons -->
            <HBox fx:id="presetsBox" alignment="CENTER_RIGHT" spacing="8"/>
        </HBox>
    </top>

    <!-- ═══════════════════ CENTER: Canvas + Slider ═══════════════════ -->
    <center>
        <VBox>
            <!-- Canvas pane grows to fill all available space -->
            <Pane fx:id="canvasPane" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #1a1a2e;">
                <Canvas fx:id="canvas"/>
            </Pane>

            <!-- Slider row -->
            <HBox alignment="CENTER" spacing="14"
                  style="-fx-background-color: #22223a; -fx-border-color: #3c3c60; -fx-border-width: 1 0 0 0;">
                <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
                <Label text="Rectangles (n)"
                       style="-fx-text-fill: #8888aa; -fx-font-size: 12px;"/>
                <Slider fx:id="nSlider" min="0" max="100" value="0"
                        HBox.hgrow="ALWAYS"
                        style="-fx-accent: #8ab4d4;"/>
                <Label fx:id="nValueLabel" text="n = 1"
                       style="-fx-text-fill: #8ab4d4; -fx-font-size: 13px; -fx-font-weight: bold; -fx-min-width: 70;"/>
            </HBox>
        </VBox>
    </center>

    <!-- ═══════════════════ RIGHT: Control Panel ═══════════════════ -->
    <right>
        <!-- Wrapped in a ScrollPane: the panel is taller than many laptop screens. Without the
             scroll pane its minimum height forces the whole view past the window edge, which
             pushed the "Rectangles (n)" slider (bottom of the centre column) off-screen. -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    prefWidth="290"
                    style="-fx-background: #22223a; -fx-background-color: #22223a; -fx-padding: 0;
                           -fx-border-color: #3c3c60; -fx-border-width: 0 0 0 1;">
            <VBox spacing="18"
                  style="-fx-background-color: #22223a;">
                <padding><Insets top="20" right="16" bottom="20" left="16"/></padding>

                <!-- ── Function ─────────────────────────────── -->
                <Label text="⨍  Function"
                       style="-fx-text-fill: #8888aa; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 8 0 2 0;"/>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="f(x) ="
                           style="-fx-text-fill: #8888aa; -fx-font-size: 12px;"/>
                    <TextField fx:id="funcField" text="0.2*x^2+3" HBox.hgrow="ALWAYS"
                               style="-fx-background-color: #2c2c4a; -fx-text-fill: #8ab4d4;
                                      -fx-border-color: #3c3c60; -fx-border-radius: 8;
                                      -fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 6 10;"/>
                </HBox>

                <!-- ── Integral Type ────────────────────────── -->
                <Label text="∫  Integral Type"
                       style="-fx-text-fill: #8888aa; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 8 0 2 0;"/>
                <ComboBox fx:id="typeBox" maxWidth="Infinity"
                          style="-fx-background-color: #2c2c4a; -fx-border-color: #3c3c60;
                                 -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #8ab4d4;"/>

                <!-- ── Bounds ────────────────────────────────── -->
                <Label text="⟦ ⟧  Bounds"
                       style="-fx-text-fill: #8888aa; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 8 0 2 0;"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="a"
                           style="-fx-text-fill: #d4aa7d; -fx-font-weight: bold; -fx-min-width: 14;"/>
                    <TextField fx:id="aField" text="0.0" prefWidth="80"
                               style="-fx-background-color: #2c2c4a; -fx-text-fill: #8ab4d4;
                                      -fx-border-color: #3c3c60; -fx-border-radius: 8;
                                      -fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 6 10;"/>
                    <Label text="b"
                           style="-fx-text-fill: #d4aa7d; -fx-font-weight: bold; -fx-min-width: 14;"/>
                    <TextField fx:id="bField" text="10.0" prefWidth="80"
                               style="-fx-background-color: #2c2c4a; -fx-text-fill: #8ab4d4;
                                      -fx-border-color: #3c3c60; -fx-border-radius: 8;
                                      -fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 6 10;"/>
                </HBox>

                <!-- ── Statistics ────────────────────────────── -->
                <Label text="📊  Statistics"
                       style="-fx-text-fill: #8888aa; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 8 0 2 0;"/>

                <!-- Estimated Area card -->
                <VBox spacing="2"
                      style="-fx-background-color: #1a1a2e; -fx-border-color: #d4887a;
                             -fx-border-width: 0 0 0 2; -fx-border-radius: 0 4 4 0; -fx-background-radius: 4;">
                    <padding><Insets top="10" right="14" bottom="10" left="14"/></padding>
                    <Label text="ESTIMATED AREA"
                           style="-fx-text-fill: #8888aa; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                    <Label fx:id="estValueLabel" text="0.0000"
                           style="-fx-text-fill: #d4887a; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                </VBox>

                <!-- Actual Area card -->
                <VBox spacing="2"
                      style="-fx-background-color: #1a1a2e; -fx-border-color: #7dc4a8;
                             -fx-border-width: 0 0 0 2; -fx-border-radius: 0 4 4 0; -fx-background-radius: 4;">
                    <padding><Insets top="10" right="14" bottom="10" left="14"/></padding>
                    <Label text="ACTUAL AREA"
                           style="-fx-text-fill: #8888aa; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                    <Label fx:id="actValueLabel" text="0.0000"
                           style="-fx-text-fill: #7dc4a8; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                </VBox>

                <!-- Error card -->
                <VBox spacing="2"
                      style="-fx-background-color: #1a1a2e; -fx-border-color: #b0a0d4;
                             -fx-border-width: 0 0 0 2; -fx-border-radius: 0 4 4 0; -fx-background-radius: 4;">
                    <padding><Insets top="10" right="14" bottom="10" left="14"/></padding>
                    <Label text="ERROR"
                           style="-fx-text-fill: #8888aa; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                    <Label fx:id="errorValueLabel" text="0.0000"
                           style="-fx-text-fill: #b0a0d4; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                </VBox>

                <!-- ── Playback ───────────────────────────────── -->
                <Label text="▶  Playback"
                       style="-fx-text-fill: #8888aa; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 8 0 2 0;"/>

                <ToggleButton fx:id="modeToggle" text="Manual Mode" maxWidth="Infinity"
                              style="-fx-background-color: transparent; -fx-text-fill: #8888aa;
                                     -fx-border-color: #3c3c60; -fx-border-radius: 4; -fx-background-radius: 4;
                                     -fx-font-size: 13px; -fx-padding: 7 14; -fx-cursor: hand;"/>

                <HBox alignment="CENTER" spacing="8">
                    <Button fx:id="startBtn" text="▶  Start" disable="true" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #2c2c4a; -fx-text-fill: #7dc4a8;
                                   -fx-border-color: #7dc4a8; -fx-border-radius: 6; -fx-background-radius: 6;
                                   -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 6 8; -fx-cursor: hand;"/>
                    <Button fx:id="pauseBtn" text="⏸  Pause" disable="true" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #2c2c4a; -fx-text-fill: #d4aa7d;
                                   -fx-border-color: #d4aa7d; -fx-border-radius: 6; -fx-background-radius: 6;
                                   -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 6 8; -fx-cursor: hand;"/>
                    <Button fx:id="restartBtn" text="⟳  Restart" disable="true" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #2c2c4a; -fx-text-fill: #d4887a;
                                   -fx-border-color: #d4887a; -fx-border-radius: 6; -fx-background-radius: 6;
                                   -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 6 8; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </right>

</BorderPane>
